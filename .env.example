# ============================================
# YAAL NILAM - Environment Configuration
# Copy this to .env and fill in your values
# ============================================

# --- Database ---
DB_PASSWORD=your_secure_database_password
DATABASE_URL=postgresql://postgres:your_secure_database_password@localhost:5432/yaalnilam
REDIS_URL=redis://localhost:6379

# --- Firebase (Frontend) ---
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# --- WhatsApp Business API ---
# Option A: Meta Cloud API (Direct)
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token
WHATSAPP_APP_SECRET=your_app_secret

# Option B: Twilio (uncomment if using Twilio)
# TWILIO_ACCOUNT_SID=your_sid
# TWILIO_AUTH_TOKEN=your_token
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- OpenAI ---
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
WHISPER_MODEL=whisper-1

# --- ElevenLabs TTS (Voice Agent) ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_TAMIL_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_ENGLISH_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
VOICE_REPLY_ENABLED=true
VOICE_REPLY_ALSO_TEXT=true

# --- Cloud Storage (AWS S3) ---
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET=yaalnilam-media
AWS_REGION=ap-south-1

# --- Node.js Gateway ---
NODE_PORT=3001
JWT_SECRET=your_jwt_secret_change_this
SESSION_TIMEOUT_MS=120000

# --- Python AI Service ---
PYTHON_AI_URL=http://localhost:8000
PYTHON_PORT=8000
CHROMADB_PATH=./data/chromadb

# --- Next.js Web Portal ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000

# --- App Config ---
APP_NAME=Yaal Nilam
APP_ENV=development
MATCH_SCORE_THRESHOLD=40
DEFAULT_SEARCH_RADIUS_KM=10

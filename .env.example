# ─────────────────────────────────────────────
# Yaal Nilam — Environment Variables Template
# Copy this to .env.local and fill in real values
# ─────────────────────────────────────────────

# ── Firebase (web + dashboard + scripts) ──
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef123456
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Database ──
DB_PASSWORD=your_db_password_here
DATABASE_URL=postgresql://postgres:your_db_password_here@localhost:5432/yaalnilam

# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── WhatsApp (Meta Cloud API) ──
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token

# ── OpenAI (Intent extraction + Whisper STT) ──
OPENAI_API_KEY=sk-your_openai_key_here
OPENAI_MODEL=gpt-4o-mini
WHISPER_MODEL=whisper-1

# ── ElevenLabs (Text-to-Speech) ──
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_TAMIL_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_ENGLISH_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
TTS_CACHE_DIR=/tmp/yaalnilam-tts

# ── Voice Config ──
VOICE_REPLY_ENABLED=true
VOICE_REPLY_ALSO_TEXT=true

# ── AWS S3 (Media uploads — optional) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=yaalnilam-media

# ── Auth ──
JWT_SECRET=your_jwt_secret_here

# ── Gateway ──
NODE_ENV=development
NODE_PORT=3001
PYTHON_AI_URL=http://localhost:8000
SESSION_TIMEOUT_MS=120000

# ── Matching Engine ──
MATCH_SCORE_THRESHOLD=0.4
DEFAULT_SEARCH_RADIUS_KM=10

          "type": 301
        },
        {
          "source": "/properties/UAfN6wCBCf0NeeUKUQbR",
          "destination": "/properties/kopay-quiet-cottage-home-2-bed-16-perch-yn-ukuqbr/",
          "type": 301
        },
        {
          "source": "/properties/UAfN6wCBCf0NeeUKUQbR/",
          "destination": "/properties/kopay-quiet-cottage-home-2-bed-16-perch-yn-ukuqbr/",
          "type": 301
        }
      ],
      "rewrites": [
        {
          "source": "/agents/**",
          "destination": "/agents/view/index.html"
        },
        {
          "source": "/properties/**",
          "destination": "/properties/view/index.html"
        },
        {
          "source": "/property/**",
          "destination": "/property/view/index.html"
        },
        {
          "source": "/preview/**",
          "destination": "/preview/view/index.html"
        },
        {
          "source": "/sitemap.xml/**",
          "destination": "/sitemap.xml"
        },
        {
          "source": "/sitemap",
          "destination": "/sitemap.xml"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "/.well-known/apple-app-site-association",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600, must-revalidate"
            },
            {
              "key": "Content-Type",
              "value": "application/json; charset=utf-8"
            }
          ]
        },
        {
          "source": "**/*.@(js|css|svg|png|jpg|jpeg|webp|avif|woff2|woff|ttf)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600, must-revalidate"
            }
          ]
        },
        {
          "source": "/_next/static/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, must-revalidate"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "SAMEORIGIN"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "Permissions-Policy",
              "value": "camera=(), payment=(), usb=(), microphone=(self), geolocation=(self)"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "SAMEORIGIN"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Strict-Transport-Security",
              "value": "max-age=31536000; includeSubDomains; preload"
            }
          ]
        },
        {
          "source": "**/@(sitemap*|feed|rss).xml",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/xml; charset=utf-8"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=600, must-revalidate"
            }
          ]
        },
        {
          "source": "/robots.txt",
          "headers": [
            {
              "key": "Content-Type",
              "value": "text/plain; charset=utf-8"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=600, must-revalidate"
            }
          ]
        },
        {
          "source": "/@(dashboard|login|register|add-listing|list-property|request-property|preview)",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        },
        {
          "source": "/@(dashboard|login|register|add-listing|list-property|request-property|preview)/**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        },
        {
          "source": "/@(properties|agents|property)/view",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        },
        {
          "source": "/@(properties|agents|property)/view/**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        }
      ],
      "predeploy": [
        "echo Predeploy ready"
      ]
    },
    {
      "target": "admin",
      "public": "dashboard/out",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "trailingSlash": true,
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**/*.@(js|css|svg|png|jpg|jpeg|webp|woff2|woff|ttf)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, must-revalidate"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "SAMEORIGIN"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "SAMEORIGIN"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Strict-Transport-Security",
              "value": "max-age=31536000; includeSubDomains; preload"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), payment=(), usb=(), microphone=(self), geolocation=(self)"
            }
          ]
        }
      ]
    }
  ]
}

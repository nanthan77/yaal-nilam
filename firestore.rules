rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role in [
          'super_admin',
          'admin',
          'listing_manager',
          'lead_manager',
          'content_manager'
        ]
      );
    }

    function isPublishedListing() {
      return resource.data.status in [
        'available',
        'approved',
        'published',
        'active',
        'Available',
        'Published'
      ];
    }

    // ---- Public-submission validation (anti-abuse for create-open collections) ----
    // These collections accept unauthenticated creates (lead capture). Validation
    // bounds document size and free-text length so the endpoints can't be used to
    // write oversized/garbage docs. Volume abuse still needs Firebase App Check.
    function fieldStr(field, maxLen) {
      return request.resource.data.get(field, '') is string
        && request.resource.data.get(field, '').size() <= maxLen;
    }
    function boundedDoc(maxKeys) {
      return request.resource.data.keys().size() <= maxKeys;
    }
    function validLead() {
      // inquiries + viewing_requests
      return boundedDoc(40)
        && fieldStr('customer_name', 300)
        && fieldStr('phone', 40)
        && fieldStr('email', 320)
        && fieldStr('message', 10000)
        && fieldStr('notes', 10000);
    }
    function validRequest() {
      // property_requests + requirements
      return boundedDoc(45)
        && fieldStr('customer_name', 300)
        && fieldStr('phone', 40)
        && fieldStr('email', 320)
        && fieldStr('notes', 10000);
    }
    function validSubmission() {
      // listing_submissions (many fields)
      return boundedDoc(60)
        && fieldStr('title', 300)
        && fieldStr('description', 20000)
        && fieldStr('owner_phone', 40)
        && fieldStr('owner_email', 320);
    }
    function validSavedSearch() {
      return boundedDoc(20)
        && fieldStr('session_id', 200)
        && fieldStr('label', 500);
    }
    function validAnalytics() {
      return boundedDoc(50)
        && fieldStr('event_name', 200)
        && fieldStr('session_id', 200);
    }

    // Public marketplace reads only published listings. Writes are admin-only.
    match /listings/{listingId} {
      allow read: if isPublishedListing() || isAdmin();
      allow write: if isAdmin();
    }

    match /areas/{areaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public lead capture. Admins manage after submission.
    match /inquiries/{inquiryId} {
      allow read: if isAdmin();
      allow create: if validLead();
      allow update, delete: if isAdmin();
    }

    match /viewing_requests/{requestId} {
      allow read: if isAdmin();
      allow create: if validLead();
      allow update, delete: if isAdmin();
    }

    match /property_requests/{requestId} {
      allow read: if isAdmin();
      allow create: if validRequest();
      allow update, delete: if isAdmin();
    }

    match /listing_submissions/{submissionId} {
      allow read: if isAdmin();
      allow create: if validSubmission();
      allow update, delete: if isAdmin();
    }

    match /requirements/{reqId} {
      allow read: if isAdmin();
      allow create: if validRequest();
      allow update, delete: if isAdmin();
    }

    // Agent profiles are public, but verification/status changes are admin-only.
    match /agents/{agentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /saved_searches/{searchId} {
      allow read, update, delete: if isAdmin();
      allow create: if validSavedSearch();
    }

    match /analytics_events/{eventId} {
      allow read, update, delete: if isAdmin();
      allow create: if validAnalytics();
    }

    // WhatsApp conversations and config are private admin surfaces.
    match /whatsapp_conversations/{convId} {
      allow read, write: if isAdmin();
      match /messages/{msgId} {
        allow read, write: if isAdmin();
      }
    }

    match /config/{configId} {
      allow read, write: if isAdmin();
    }

    match /admin_users/{userId} {
      allow read, write: if isAdmin();
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Owner emails that get admin access without a custom claim being set.
    // Safe because the email must be provider-verified (Google verifies it),
    // and it mirrors the dashboard's client-side allowlist. Add proper custom
    // claims (scripts/set-admin-claims.mjs) for additional staff.
    function isOwnerEmail() {
      return request.auth.token.email_verified == true &&
        request.auth.token.email in ['nanthan77@gmail.com'];
    }

    function isAdminUserRecord() {
      return signedIn() &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/admin_users/$(request.auth.token.email)) &&
        get(/databases/$(database)/documents/admin_users/$(request.auth.token.email)).data.status == 'active' &&
        get(/databases/$(database)/documents/admin_users/$(request.auth.token.email)).data.role in [
          'super_admin',
          'admin',
          'listing_manager',
          'lead_manager',
          'content_manager'
        ];
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role in [
          'super_admin',
          'admin',
          'listing_manager',
          'lead_manager',
          'content_manager'
        ] ||
        isOwnerEmail() ||
        isAdminUserRecord()
      );
    }

    function isPublishedListing() {
      return resource.data.status in [
        'available',
        'approved',
        'published',
        'active',
        'Available',
        'Published'
      ];
    }

    // ---- Public-submission validation (anti-abuse for create-open collections) ----
    // These collections accept unauthenticated creates (lead capture). Validation
    // bounds document size and free-text length so the endpoints can't be used to
    // write oversized/garbage docs. Volume abuse still needs Firebase App Check.
    function fieldStr(field, maxLen) {
      return request.resource.data.get(field, '') is string
        && request.resource.data.get(field, '').size() <= maxLen;
    }
    function boundedDoc(maxKeys) {
      return request.resource.data.keys().size() <= maxKeys;
    }
    function validLead() {
      // inquiries + viewing_requests
      return boundedDoc(40)
        && fieldStr('customer_name', 300)
        && fieldStr('phone', 40)
        && fieldStr('email', 320)
        && fieldStr('message', 10000)
        && fieldStr('notes', 10000);
    }
    function validRequest() {
      // property_requests + requirements
      return boundedDoc(45)
        && fieldStr('customer_name', 300)
        && fieldStr('phone', 40)
        && fieldStr('email', 320)
        && fieldStr('notes', 10000);
    }
    function validSubmission() {
      // listing_submissions (many fields)
      return boundedDoc(60)
        && fieldStr('title', 300)
        && fieldStr('description', 20000)
        && fieldStr('owner_phone', 40)
        && fieldStr('owner_email', 320);
    }
    function isSubmissionOwner() {
      return signedIn() && (
        resource.data.get('agent_id', '') == request.auth.uid ||
        (
          request.auth.token.email != null &&
          (
            resource.data.get('owner_email', '') == request.auth.token.email ||
            resource.data.get('agent_email', '') == request.auth.token.email
          )
        )
      );
    }
    function validUserProfile(userId) {
      return boundedDoc(20)
        && request.resource.data.uid == userId
        && request.resource.data.user_type in ['buyer', 'seller', 'agent']
        && fieldStr('name', 300)
        && fieldStr('email', 320)
        && fieldStr('phone', 40);
    }
    function validAgentCreate(agentId) {
      return boundedDoc(55)
        && request.resource.data.uid == agentId
        && request.resource.data.role == 'agent'
        && request.resource.data.status == 'pending'
        && request.resource.data.verified == false
        && request.resource.data.nic_uploaded == false
        && fieldStr('name', 300)
        && fieldStr('email', 320)
        && fieldStr('phone', 40)
        && fieldStr('whatsapp', 40)
        && fieldStr('company', 300)
        && fieldStr('logo_url', 1000)
        && fieldStr('agency_type', 120)
        && fieldStr('public_email', 320)
        && fieldStr('internal_email', 320)
        && fieldStr('website', 1000)
        && fieldStr('office_address', 1000)
        && fieldStr('company_registration_no', 120)
        && fieldStr('license_no', 120)
        && fieldStr('business_hours', 240)
        && fieldStr('agency_plan', 80)
        && fieldStr('billing_status', 80)
        && fieldStr('source', 80)
        && request.resource.data.service_areas is list
        && request.resource.data.service_areas.size() <= 20
        && request.resource.data.specializations is list
        && request.resource.data.specializations.size() <= 20
        && request.resource.data.languages is list
        && request.resource.data.languages.size() <= 10
        && request.resource.data.active_listings is number
        && request.resource.data.total_inquiries is number
        && request.resource.data.response_rate is number
        && request.resource.data.team_size is number
        && request.resource.data.years_experience is number;
    }
    function validPrivateAgentCreate(agentId) {
      return boundedDoc(20)
        && request.resource.data.uid == agentId
        && request.resource.data.internal_email is string
        && request.resource.data.internal_email.size() <= 320
        && request.resource.data.agency_plan == 'starter'
        && request.resource.data.billing_status == 'free'
        && fieldStr('office_address', 500)
        && fieldStr('company_registration_no', 120)
        && fieldStr('license_no', 120)
        && fieldStr('account_manager', 120)
        && fieldStr('internal_notes', 1000)
        && fieldStr('source', 80);
    }
    function validSavedSearch() {
      return boundedDoc(20)
        && fieldStr('session_id', 200)
        && fieldStr('label', 500);
    }
    function validAnalytics() {
      return boundedDoc(50)
        && fieldStr('event_name', 200)
        && fieldStr('session_id', 200);
    }
    function validAlert() {
      // property_alerts — buyer alert registrations (public create)
      return boundedDoc(25)
        && request.resource.data.whatsapp is string
        && request.resource.data.whatsapp.size() >= 7
        && request.resource.data.whatsapp.size() <= 40
        && fieldStr('email', 320)
        && fieldStr('name', 200)
        && request.resource.data.purpose in ['buy', 'rent']
        && fieldStr('property_type', 40)
        && fieldStr('area', 80)
        && request.resource.data.get('min_bedrooms', 0) is number
        && request.resource.data.get('max_price', 0) is number
        && request.resource.data.status == 'active';
    }
    function validAuditLog() {
      // audit_logs — append-only admin action trail
      return boundedDoc(30)
        && request.resource.data.action is string
        && request.resource.data.action.size() >= 1
        && request.resource.data.action.size() <= 200
        && request.resource.data.entity_type is string
        && request.resource.data.entity_type.size() >= 1
        && request.resource.data.entity_type.size() <= 100
        && request.resource.data.performed_by is string
        && request.resource.data.performed_by.size() >= 1
        && request.resource.data.performed_by.size() <= 320
        && fieldStr('entity_id', 200)
        && fieldStr('details', 10000);
    }

    // Public marketplace reads only published listings. Writes are admin-only.
    match /listings/{listingId} {
      allow read: if isPublishedListing() || isAdmin();
      allow write: if isAdmin();
    }

    match /areas/{areaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public lead capture. Admins manage after submission.
    match /inquiries/{inquiryId} {
      allow read: if isAdmin();
      allow create: if validLead();
      allow update, delete: if isAdmin();
    }

    match /viewing_requests/{requestId} {
      allow read: if isAdmin();
      allow create: if validLead();
      allow update, delete: if isAdmin();
    }

    match /property_requests/{requestId} {
      allow read: if isAdmin();
      allow create: if validRequest();
      allow update, delete: if isAdmin();
    }

    match /listing_submissions/{submissionId} {
      allow read: if isAdmin() || isSubmissionOwner();
      allow create: if validSubmission();
      allow update, delete: if isAdmin();
    }

    match /requirements/{reqId} {
      allow read: if isAdmin();
      allow create: if validRequest();
      allow update, delete: if isAdmin();
    }

    // Agent profiles are public, but verification/status changes are admin-only.
    match /agents/{agentId} {
      allow read: if true;
      allow create: if signedIn()
        && request.auth.uid == agentId
        && validAgentCreate(agentId);
      allow update, delete: if isAdmin();
    }

    match /agent_private/{agentId} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == agentId);
      allow list: if isAdmin();
      allow create: if isAdmin() || (
        signedIn()
        && request.auth.uid == agentId
        && validPrivateAgentCreate(agentId)
      );
      allow update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create: if signedIn()
        && request.auth.uid == userId
        && validUserProfile(userId);
      allow update: if signedIn()
        && request.auth.uid == userId
        && validUserProfile(userId)
        && request.resource.data.user_type == resource.data.user_type;
      allow delete: if isAdmin();
    }

    match /saved_searches/{searchId} {
      allow read, update, delete: if isAdmin();
      allow create: if validSavedSearch();
    }

    match /analytics_events/{eventId} {
      allow read, update, delete: if isAdmin();
      allow create: if validAnalytics();
    }

    // Buyer property-alert registrations: anyone can register (validated);
    // only admins (and the Cloud Function via Admin SDK) read/manage them.
    match /property_alerts/{alertId} {
      allow read: if isAdmin();
      allow create: if validAlert();
      allow update, delete: if isAdmin();
    }

    // Delivery log written by the alerts Cloud Function (Admin SDK); admin-read.
    match /alert_deliveries/{deliveryId} {
      allow read, write: if isAdmin();
    }

    // WhatsApp conversations and config are private admin surfaces.
    match /whatsapp_conversations/{convId} {
      allow read, write: if isAdmin();
      match /messages/{msgId} {
        allow read, write: if isAdmin();
      }
    }

    // Agent-guide tutorial videos are shown on the public /for-agents page,
    // so this single config doc is world-readable. Edits stay admin-only.
    match /config/agent_guide {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/{configId} {
      allow read, write: if isAdmin();
    }

    // Social lead monitor CRM: discovered public posts, manual imports, and
    // monitor run logs are admin-only. Cloud Functions write with Admin SDK.
    match /social_leads/{leadId} {
      allow read, write: if isAdmin();
    }

    match /social_monitor_runs/{runId} {
      allow read, write: if isAdmin();
    }

    // Admin action audit trail. Append-only: admins can create and read,
    // but entries can never be updated or deleted (immutable log).
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validAuditLog();
      allow update, delete: if false;
    }

    match /admin_users/{userId} {
      allow get: if isAdmin() || (
        signedIn()
        && request.auth.token.email == userId
        && resource.data.status == 'active'
        && resource.data.role in [
          'super_admin',
          'admin',
          'listing_manager',
          'lead_manager',
          'content_manager'
        ]
      );
      allow list, create, update, delete: if isAdmin();
    }
  }
}
